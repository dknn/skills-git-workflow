#!/bin/sh
set -eu

zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
scanner=$(git config --local --get localguard.gitleaksPath || printf '%s' gitleaks)
updates=0
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" = refs/heads/main ]; then
        echo >&2 'Local guard: all pushes to main are blocked. Use a pull request.'
        exit 1
    fi
    if [ "$local_oid" = "$zero" ]; then
        echo >&2 'Local guard: remote ref deletion is blocked.'
        exit 1
    fi
    if [ "$remote_oid" != "$zero" ]; then
        if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
            echo >&2 'Local guard: remote commit is unavailable. Fetch before pushing.'
            exit 1
        fi
        if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
            echo >&2 'Local guard: history rewriting is blocked.'
            exit 1
        fi
        range="$remote_oid..$local_oid"
    else
        range="$local_oid"
    fi
    if ! command -v "$scanner" >/dev/null 2>&1; then
        echo >&2 'Local guard: gitleaks is required; push blocked.'
        exit 1
    fi
    "$scanner" git . --log-opts="$range" --redact=100 --no-banner --timeout=120
    updates=1
done

if [ "$updates" = 1 ]; then
    if ! command -v pwsh >/dev/null 2>&1; then
        echo >&2 'Local guard: PowerShell 7 is required; push blocked.'
        exit 1
    fi
    pwsh -NoProfile -File ./tests/Test-GitWorkflowSkill.ps1
    pwsh -NoProfile -File ./tests/Test-GitRepositorySettingsSkill.ps1
fi
